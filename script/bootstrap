#!/usr/bin/env bash
#
# set up dotfiles

export PATH="./bin:$PATH"

cd "$(dirname "$0")/.."
DOTFILES_ROOT="$(pwd -P)"

set -e

source "$DOTFILES_ROOT/script/lib.sh"

# Ensure Xcode Command Line Tools are installed on macOS
if [[ "$(uname)" == "Darwin" ]]; then
  if ! xcode-select -p &>/dev/null; then
    dotlog "info" "installing Xcode Command Line Tools..."
    xcode-select --install
    echo "Press any key when the installation has completed."
    read -r -n 1 </dev/tty
  fi
fi

echo ''

setup_gitconfig () {
  if [[ ! -f git/gitconfig.local.symlink ]]; then
    dotlog "info" 'setup gitconfig'

    git_credential='cache'
    if [[ "$(uname)" == "Darwin" ]]; then
      git_credential='osxkeychain'
    fi

    dotlog "user" ' - What is your github author name?'
    read -r git_authorname </dev/tty
    dotlog "user" ' - What is your github author email?'
    read -r git_authoremail </dev/tty

    # Escape sed special characters in user input
    git_authorname_escaped="${git_authorname//\\/\\\\}"
    git_authorname_escaped="${git_authorname_escaped//\//\\/}"
    git_authorname_escaped="${git_authorname_escaped//&/\\&}"

    git_authoremail_escaped="${git_authoremail//\\/\\\\}"
    git_authoremail_escaped="${git_authoremail_escaped//\//\\/}"
    git_authoremail_escaped="${git_authoremail_escaped//&/\\&}"

    sed -e "s/AUTHORNAME/$git_authorname_escaped/g" -e "s/AUTHOREMAIL/$git_authoremail_escaped/g" -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" git/gitconfig.local.symlink.example > git/gitconfig.local.symlink

    dotlog "success" 'gitconfig'
  fi
}

link_file () {
  local src=$1 dst=$2

  # -e alone is false for a broken symlink, which would then fail the ln below.
  if [[ -e "$dst" || -L "$dst" ]]; then
    if [[ "$(readlink "$dst")" == "$src" ]]; then
      dotlog "skip" "$dst"
      return 0
    fi

    if ! prompt_collision "$dst"; then
      exit 1
    fi

    case "$collision_action" in
      skip)
        dotlog "skip" "$dst"
        return 0
        ;;
      overwrite)
        rm -rf "$dst"
        dotlog "success" "removed $dst"
        ;;
      backup)
        mv "$dst" "$dst.backup"
        dotlog "success" "moved $dst to $dst.backup"
        ;;
    esac
  fi

  ln -s "$src" "$dst"
  dotlog "success" "linked $src to $dst"
}

install_dotfiles () {
  dotlog "info" 'installing dotfiles'

  # `find` rather than a `**` glob — macOS ships bash 3.2, which has no globstar.
  local src dst
  while IFS= read -r src; do
    dst="$HOME/.$(basename "${src%.*}")"
    link_file "$src" "$dst"
  done < <(find "$DOTFILES_ROOT" -name '*.symlink' -type f -not -path '*/.git/*' | sort)
}

setup_gitconfig
install_dotfiles

# Install dependencies (macOS defaults/hostname + Homebrew on all platforms)
dotlog "info" "installing dependencies"
if source bin/dot; then
  dotlog "success" "dependencies installed"
else
  dotlog "error" "error installing dependencies"
fi

# Locate the brew binary — it won't be on PATH in the current shell after
# a fresh install since the shell config hasn't been reloaded.
BREW_BIN="$(command -v brew 2>/dev/null || true)"
if [[ -z "$BREW_BIN" ]]; then
  for p in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
    if [[ -f "$p" ]]; then
      BREW_BIN="$p"
      break
    fi
  done
fi

if [[ -n "$BREW_BIN" ]]; then
  dotlog "install" "Installing homebrew packages..."
  "$BREW_BIN" bundle --file="$HOME/.dotfiles/homebrew/Brewfile"
fi