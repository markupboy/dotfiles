#!/usr/bin/env bash
#
# Link topic directories into ~/.config.
#
# Each entry is a topic directory in this repo, linked to ~/.config/<same name>.
# A topic that needs a config directory names itself after it.

set -e

export DOTFILES="${DOTFILES:-$(cd "$(dirname "$0")/.." && pwd -P)}"

source "$DOTFILES/script/lib.sh"

CONFIG_LINKS=(
  fish
  ghostty
  herdr
  nvim
  worktrunk
)

# 0 linked or skipped, 1 failed, 2 user asked to quit
link_config () {
  local src="$DOTFILES/$1" dst="$HOME/.config/$1"

  if [ -L "$dst" ]; then
    if [ "$(readlink "$dst")" = "$src" ]; then
      dotlog "skip" "$dst"
      return 0
    fi
    rm -f "$dst"                          # stale or broken link
  elif [ -e "$dst" ]; then
    prompt_collision "$dst" || return $?

    case "$collision_action" in
      skip)
        dotlog "skip" "$dst"
        return 0
        ;;
      overwrite)
        rm -rf "$dst"
        dotlog "success" "removed $dst"
        ;;
      backup)
        mv "$dst" "$dst.backup"
        dotlog "success" "moved $dst to $dst.backup"
        ;;
    esac
  fi

  dotlog "install" "$dst -> $src"
  ln -sfn "$src" "$dst"
}

mkdir -p "$HOME/.config"

status=0
for topic in "${CONFIG_LINKS[@]}"; do
  rc=0
  link_config "$topic" || rc=$?
  case $rc in
    0) ;;
    2) exit 1 ;;
    *) status=1 ;;
  esac
done

exit $status
