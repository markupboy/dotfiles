#!/usr/bin/env bash
#
# dotlog -- badge-prefixed log output for the dotfiles scripts
#
# Usage: dotlog <info|install|success|skip|user|error|divider> [message...]

FG_BLACK=$'\033[30m'
BG_GREEN=$'\033[42m'
BG_RED=$'\033[41m'
BG_YELLOW=$'\033[43m'
FG_CYAN=$'\033[36m'
BG_CYAN=$'\033[46m'
RESET=$'\033[0m'

type=$1
shift
message="$*"

case $type in
    info)
        printf '%s%s info %s %b\n' "$BG_CYAN" "$FG_BLACK" "$RESET" "$message"
        ;;
    install)
        printf '%s%s install %s %b\n' "$BG_GREEN" "$FG_BLACK" "$RESET" "$message"
        ;;
    success)
        printf '%s%s ok %s %b\n' "$BG_GREEN" "$FG_BLACK" "$RESET" "$message"
        ;;
    skip)
        printf '%s%s skipping %s %b\n' "$BG_YELLOW" "$FG_BLACK" "$RESET" "$message"
        ;;
    user)
        printf '%s%s user %s %b\n' "$BG_YELLOW" "$FG_BLACK" "$RESET" "$message"
        ;;
    error)
        printf '%s%s error %s %b\n' "$BG_RED" "$FG_BLACK" "$RESET" "$message"
        ;;
    divider)
        printf '%s_________________________________%s\n' "$FG_CYAN" "$RESET"
        ;;
    *)
        printf '%s info %s %b\n' "$BG_CYAN" "$RESET" "$message"
        ;;
esac
