#!/bin/sh
#
# Clear local repo of branches already merged into the default branch,
# including branches merged through a GitHub squash merge.

# Determine the default branch (origin's HEAD), falling back to main/master.
default_branch=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')
if [ -z "$default_branch" ]; then
  if git show-ref --verify --quiet refs/heads/main; then
    default_branch=main
  elif git show-ref --verify --quiet refs/heads/master; then
    default_branch=master
  else
    echo "Could not determine the default branch." >&2
    exit 1
  fi
fi

# A squash merge does not preserve the branch tip in the default branch's
# history. GitHub does preserve that tip on the merged PR, so require an exact
# match before force-deleting a branch that Git cannot identify as merged.
has_merged_pr_for_tip() {
  command -v gh >/dev/null 2>&1 || return 1
  gh pr list --state merged --base "$default_branch" --head "$1" \
    --json headRefOid --limit 100 \
    --jq '.[].headRefOid' 2>/dev/null \
    | grep -qxF "$2"
}

# Exclude branches checked out in this or another worktree (marked with * or +)
# and the default branch itself.
git branch \
  | grep -v '^[*+]' \
  | sed 's/^[[:space:]]*//' \
  | grep -vxF "$default_branch" \
  | while IFS= read -r branch; do
      [ -n "$branch" ] || continue

      if git merge-base --is-ancestor "$branch" "$default_branch"; then
        git branch -d "$branch"
      else
        tip=$(git rev-parse --verify "refs/heads/$branch")
        if has_merged_pr_for_tip "$branch" "$tip" \
          && [ "$(git rev-parse --verify "refs/heads/$branch")" = "$tip" ]; then
          git branch -D "$branch"
        fi
      fi
    done
