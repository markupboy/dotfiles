# Project Specific Files #
##########################
nvim/lazy-lock.json
git/gitconfig.local.symlink
.claude/settings.local.json
local.ghostty

# herdr writes runtime state into its config dir, which IS this repo
herdr/session.json
herdr/.plugins.lock
herdr/*.sock

# fish writes runtime state into its config dir, which IS this repo
fish/fish_variables
fish/completions/*
!fish/completions/.gitkeep

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
ehthumbs.db
Icon?
Thumbs.db
