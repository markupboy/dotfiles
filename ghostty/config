# appearance
theme = "one-dark.conf"
font-family = "Consolas 7NF"
font-size = 12
adjust-cell-width = -11%
background-opacity = 0.8
unfocused-split-opacity = 0.8
unfocused-split-fill = #333
background-blur = 40
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
cursor-color = cell-foreground
cursor-text = cell-background
minimum-contrast = 1.3

# local overrides
config-file = ?local.ghostty

# macOS-specific settings
macos-option-as-alt = true
macos-non-native-fullscreen = visible-menu
macos-titlebar-style = tabs
macos-icon = custom-style
macos-icon-ghost-color = #cf6757
macos-icon-screen-color = #888888
macos-icon-frame = aluminum

# OS controls
clipboard-read = "allow"
clipboard-paste-protection = false

# window controls
confirm-close-surface = true
window-decoration = true
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true
window-save-state = always
window-title-font-family = "Consolas 7NF"

# Let tmux own the title (see set-titles in tmux/tmux.conf.symlink)
shell-integration-features = no-title

# auto update settings
auto-update = download
auto-update-channel = stable

# custom keybindings
keybind = super+r=reload_config
keybind = super+i=inspector:toggle
keybind = super+f=toggle_fullscreen
keybind = super+left=previous_tab
keybind = super+right=next_tab
keybind = shift+enter=text:\n
