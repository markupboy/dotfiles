# --- General Tmux Settings ---
set -g default-terminal "tmux-256color"
set -sa terminal-overrides ",*-256color*:RGB"          # true color
set -g mouse on
set -s escape-time 0                      # no ESC delay in vim
set -g history-limit 10000

# --- Shell ---
# New panes get fish wherever it lives, so tmux-continuum's restored sessions
# don't keep spawning whatever shell tmux was originally started from.
# Last matching line wins, so the preferred prefix is checked last.
if-shell '[ -x /usr/bin/fish ]'                      'set -g default-shell /usr/bin/fish'
if-shell '[ -x /home/linuxbrew/.linuxbrew/bin/fish ]' 'set -g default-shell /home/linuxbrew/.linuxbrew/bin/fish'
if-shell '[ -x /usr/local/bin/fish ]'                'set -g default-shell /usr/local/bin/fish'
if-shell '[ -x /opt/homebrew/bin/fish ]'             'set -g default-shell /opt/homebrew/bin/fish'

# --- Terminal (Ghostty) window title ---
# Let tmux drive the outer terminal title, using the pane's dir name.
set -g set-titles on
set -g set-titles-string "#{b:pane_current_path}"

# --- Custom Key Bindings for Panes ---
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# --- Pane Navigation with Alt + Arrow Keys ---
# -n binds without the prefix key
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D

# --- Status Bar Styling ---
set -g status-style bg=default
set -g status-left-length 40
set -g status-left "#[fg=green]Session: #S #[fg=yellow]• "
set -g status-right "#[fg=cyan]%H:%M #[fg=magenta]%d-%b-%y"

# --- Tmux Plugin Manager (TPM) & Plugins ---
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

# continuum drives resurrect automatically — restore on tmux start
set -g @continuum-restore 'on'

# Initialize TPM. This line MUST be at the very end of .tmux.conf
run '~/.tmux/plugins/tpm/tpm'
